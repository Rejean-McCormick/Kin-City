source(shared,"SignTheme",[[
local Districts=require(script.Parent.HexagonalDistricts)
local SignTheme={}
SignTheme.version="31.9.6"
SignTheme.layout={
pixelsPerStud=38,
maxDistance=190,
minWidth=5,
maxWidth=42,
minHeight=1.6,
maxHeight=7.2,
}
SignTheme.palettes={
neutral={background=Color3.fromRGB(14,55,52),accent=Color3.fromRGB(30,104,100),border=Color3.fromRGB(196,226,216),text=Color3.fromRGB(244,250,245)},
keenkonnect={background=Color3.fromRGB(30,62,62),accent=Color3.fromRGB(30,104,100),border=Color3.fromRGB(188,204,202),text=Color3.fromRGB(244,250,245)},
ethikos={background=Color3.fromRGB(62,43,30),accent=Color3.fromRGB(30,104,100),border=Color3.fromRGB(216,178,128),text=Color3.fromRGB(249,242,222)},
kreative={background=Color3.fromRGB(67,38,56),accent=Color3.fromRGB(203,128,157),border=Color3.fromRGB(236,197,205),text=Color3.fromRGB(255,245,240)},
uckk={background=Color3.fromRGB(32,47,63),accent=Color3.fromRGB(137,158,181),border=Color3.fromRGB(222,216,190),text=Color3.fromRGB(252,249,236)},
ekole={background=Color3.fromRGB(25,29,30),accent=Color3.fromRGB(30,104,100),border=Color3.fromRGB(234,238,235),text=Color3.fromRGB(247,248,246)},
konnected={background=Color3.fromRGB(20,24,27),accent=Color3.fromRGB(30,104,100),border=Color3.fromRGB(206,168,102),text=Color3.fromRGB(251,242,218)},
}
for _,section in ipairs(Districts.sections) do
SignTheme.palettes[section.key].accent=section.color
SignTheme.palettes[section.key].border=section.color
end
local AXES=Districts.sections
function SignTheme.infer(parent:Instance,position:Vector3?,forced:string?):string
if forced and SignTheme.palettes[forced] then return forced end
local node:Instance?=parent
while node do
if node:GetAttribute("KinHaloOwner")~=nil then return "neutral" end
node=node.Parent
end
node=parent
while node do
local key=node:GetAttribute("KinSection") or node:GetAttribute("KinSector")
if type(key)=="string" and SignTheme.palettes[key] then return key end
node=node.Parent
end
if position then
local r=math.sqrt(position.X*position.X+position.Z*position.Z)
if r>90 and r<595 then
local best="neutral"
local maxDot=-1
for _,s in ipairs(AXES) do
local dot=(position.X*s.x+position.Z*s.z)/r
if dot>maxDot then maxDot=dot;best=s.key end
end
return best
end
end
return "neutral"
end
function SignTheme.palette(section:string)
return SignTheme.palettes[section] or SignTheme.palettes.neutral
end
return SignTheme

]])
source(shared,"Typography",[[
local Typography={}
local function resolve(name:string): Enum.Font?
local ok, value = pcall(function()
return Enum.Font[name]
end)
if ok and value then return value end
return nil
end
local GARAMOND=resolve("Garamond")
local BODONI=resolve("Bodoni")
local SELECTED=GARAMOND or BODONI or Enum.Font.SourceSans
function Typography.body(): Enum.Font
return SELECTED
end
function Typography.bold(): Enum.Font
return SELECTED
end
function Typography.display(): Enum.Font
return SELECTED
end
function Typography.fallback(): Enum.Font
return BODONI or SELECTED
end
return Typography

]])
source(shared,"UrbanV14Destinations",[[
local RS=game:GetService("ReplicatedStorage")
local stages=require(RS:WaitForChild("KinCityShared"):WaitForChild("CivicDestinations"))
local register={arcades={},workshops={}}
local crafts={
{title="Librairie des voyages",kind="books",color={205,165,108}},
{title="Atelier des horloges",kind="clock",color={137,188,187}},
{title="Salon des jardins",kind="botany",color={123,180,120}},
{title="Cabinet des inventions",kind="science",color={148,164,219}},
{title="Maison des couleurs",kind="art",color={220,154,142}},
{title="Atelier de musique",kind="music",color={202,169,203}},
{title="Cartographie du monde",kind="maps",color={162,182,205}},
{title="Objets du mouvement",kind="motion",color={222,189,112}},
}
for i,design in ipairs(crafts) do
local side=if i<=4 then -1 else 1
local row=(i-1)%4
local center={side*64,0,85+row*21}
table.insert(register.arcades,{
id=string.format("kin.station.arcade.%02d",i),title=design.title,
kind=design.kind,color=design.color,center_studs=center,
yaw=-side*math.pi/2,side=side,
})
end
local titles={
"Atelier du vivant","Atelier du savoir","Atelier des couleurs",
"Atelier du mouvement","Atelier du lien","Atelier des inventions",
}
for i,stage in ipairs(stages) do
local cf=CFrame.new(stage.center_studs[1],0,stage.center_studs[3])*CFrame.Angles(0,stage.yaw,0)*CFrame.new(-43,0,-3)
local p=cf.Position
table.insert(register.workshops,{
id=string.format("kin.public.workshop.%02d",i),title=titles[i],
theme=stage.theme,color=stage.color,
center_studs={p.X,0,p.Z},yaw=stage.yaw,stage_id=stage.id,
})
end
return register

]])
