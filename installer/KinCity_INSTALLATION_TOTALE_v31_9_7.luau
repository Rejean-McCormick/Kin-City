button.TextColor3=Color3.fromRGB(239,243,239)
button.TextSize=15
button.Font=Typography.body()
button.BackgroundColor3=Color3.fromRGB(50,101,111)
button.Parent=parent
corner(button,8)
button.Activated:Connect(action)
return button
end
function Vista.start(remote)
