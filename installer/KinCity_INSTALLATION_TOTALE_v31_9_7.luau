source(server,"OpalWayfindingV19",[[
local Kit=require(script.Parent.CrystalKit)
local Wayfinding={}
local function addSegment(groups,a,b)
local horizontal=a[3]==b[3]
local fixed=if horizontal then a[3] else a[1]
local first=math.min(if horizontal then a[1] else a[3],if horizontal then b[1] else b[3])
local last=math.max(if horizontal then a[1] else a[3],if horizontal then b[1] else b[3])
if last-first<0.1 then return end
local key=(if horizontal then "H" else "V")..":"..tostring(fixed)
if not groups[key] then groups[key]={horizontal=horizontal,fixed=fixed,intervals={}} end
table.insert(groups[key].intervals,{first,last})
end
local function stripe(folder,a,b,side,color,isVertical)
local direction=b-a
local distance=direction.Magnitude
if distance<3 then return end
local forward=direction.Unit
local perpendicular=Vector3.new(forward.Z,0,-forward.X)
local center=(a+b)/2+perpendicular*side
local y=if isVertical then 0.292 else 0.27
center=Vector3.new(center.X,y,center.Z)
local part=Kit.part(folder,"Part","Veine de guidage unifiée",Vector3.new(0.24,0.08,distance),CFrame.lookAt(center,center+forward),color,Enum.Material.Metal)
part.CanCollide=false;part.CanTouch=false;part.CanQuery=false;part.CastShadow=false
part:SetAttribute("KinOptionalDetail",true)
end
function Wayfinding.make(city,plan)
local folder=Instance.new("Folder")
folder.Name="Filigranes de promenade — v29"
folder.Parent=city
folder:SetAttribute("KinArtTheme","sarcelle-cristal-v29")
local density=Kit.profile=="LITE" and 1 or 2
local groups={}
for _,route in ipairs(plan.pedestrian_paths) do
for i=2,#route.path_xyz_studs do
addSegment(groups,route.path_xyz_studs[i-1],route.path_xyz_studs[i])
end
end
local count=0
local keys={}
for key in pairs(groups) do table.insert(keys,key) end
table.sort(keys)
for _,key in ipairs(keys) do
local group=groups[key]
table.sort(group.intervals,function(a,b)return a[1]<b[1] end)
local merged={}
for _,interval in ipairs(group.intervals) do
local last=merged[#merged]
if last and interval[1]<=last[2]+0.001 then
last[2]=math.max(last[2],interval[2])
else
table.insert(merged,{interval[1],interval[2]})
end
end
for _,interval in ipairs(merged) do
local a,b
if group.horizontal then
a=Vector3.new(interval[1],0,group.fixed)
b=Vector3.new(interval[2],0,group.fixed)
else
a=Vector3.new(group.fixed,0,interval[1])
b=Vector3.new(group.fixed,0,interval[2])
end
local side=math.max(1.25,math.min(6*0.31,3.5))
stripe(folder,a,b,-side,Kit.primary,not group.horizontal)
count+=1
if density==2 then
stripe(folder,a,b,side,Kit.gold,not group.horizontal)
count+=1
end
end
end
folder:SetAttribute("KinMergedOpalVeins",count)
return folder
end
return Wayfinding

]])
source(server,"OutdoorAtmosphere",[[
local F=require(script.Parent.Factory)
local Lighting=game:GetService("Lighting")
local Atmos={}
local fol=Color3.fromRGB(79,143,98)
local function spot(parent,x,z,index)
local m=F.folder(parent,"Jardin lumineux")
local stem=F.part(m,"Rosier",Vector3.new(0.7,6,0.7),CFrame.new(x,3,z),fol,Enum.Material.Grass)
stem.CanCollide=false
local orb=F.part(m,"Orbe végétal",Vector3.new(2.4,2.4,2.4),CFrame.new(x,6.6,z),Color3.fromRGB(170,224,210),Enum.Material.Slate)
orb.CanCollide=false
orb.Shape=Enum.PartType.Ball
for n=1,3 do
local a=n*math.pi*2/3
local x2,z2=x+math.cos(a)*3,z+math.sin(a)*3
local lamp=F.part(m,"Lanterne",Vector3.new(0.7,0.7,0.7),CFrame.new(x2,4.5+(index%2),z2),Color3.fromRGB(254,207,119),Enum.Material.Neon)
lamp.Shape=Enum.PartType.Ball
lamp.CanCollide=false
lamp:SetAttribute("KinFirefly",true)
lamp:SetAttribute("KinFireflyPhase",index*0.7+n)
if n==1 then
local point=Instance.new("PointLight")
point.Brightness=0.26
point.Range=9
point.Shadows=false
point.Parent=lamp
end
end
end
function Atmos.make(city)
local folder=F.folder(city,"Paysages d'ambiance")
for i=1,24 do
local angle=2*math.pi*(i-1)/24
local radius=124+(i%3)*20
spot(folder,math.cos(angle)*radius,math.sin(angle)*radius,i)
end
local shrine=F.folder(folder,"Anneaux de la connaissance")
for i=1,8 do
local angle=2*math.pi*i/8
local r=28
local orb=F.part(shrine,"Pierre du savoir",Vector3.new(3.6,3.6,3.6),CFrame.new(math.cos(angle)*r,2.2,math.sin(angle)*r),Color3.fromRGB(197,239,231),Enum.Material.Slate)
orb.Shape=Enum.PartType.Ball
orb.CanCollide=false
local aura=Instance.new("PointLight")
aura.Brightness=0.35;aura.Range=11;aura.Parent=orb
end
return folder
end
function Atmos.start(world)
task.spawn(function()
local parts={}
local city=world:FindFirstChild("Ville")
local f=city and city:FindFirstChild("Paysages d'ambiance")
if not f then return end
for _,p in ipairs(f:GetDescendants()) do
if p:IsA("BasePart") and p:GetAttribute("KinFirefly") then table.insert(parts,p) end
end
while world.Parent do
local night=(Lighting.ClockTime<6.4 or Lighting.ClockTime>18.2)
local now=os.clock()
for _,p in ipairs(parts) do
if p.Parent then
local light=p:FindFirstChildOfClass("PointLight")
if light then light.Enabled=night;light.Brightness=0.22+0.1*math.sin(now*1.8+(p:GetAttribute("KinFireflyPhase") or 0)) end
p.Transparency=night and 0.06 or 0.58
end
end
task.wait(2.4)
end
end)
end
return Atmos

]])
source(server,"OutdoorCinema",[[
local Players=game:GetService("Players")
local Cinema={}
local MODEL_NAME="KinCityOutdoorCinema"
local DEFAULT_VIDEO_ID=0
local DEFAULT_POSITION=Vector3.new(105,0,-75)
local started=false
local function part(parent:Instance,name:string,size:Vector3,cf:CFrame,color:Color3,material:Enum.Material,collide:boolean)
local p=Instance.new("Part")
p.Name=name
p.Size=size
p.CFrame=cf
p.Color=color
p.Material=material
p.Anchored=true
p.CanCollide=collide
p.CanTouch=false
p.CanQuery=collide
p.Parent=parent
return p
end
local function label(parent:Instance,name:string,text:string,size:UDim2,position:UDim2,color:Color3,px:number)
local t=Instance.new("TextLabel")
t.Name=name
t.BackgroundTransparency=1
t.Size=size
t.Position=position
t.Text=text
t.TextColor3=color
t.Font=Enum.Font.Garamond
t.TextScaled=true
t.TextWrapped=true
t.Parent=parent
local limit=Instance.new("UITextSizeConstraint")
limit.MaxTextSize=px
limit.MinTextSize=12
limit.Parent=t
return t
end
local function setVideo(model:Model)
local screen=model:FindFirstChild("Écran",true)
if not screen or not screen:IsA("BasePart") then return end
local surface=screen:FindFirstChild("Projection")
if not surface then return end
local video=surface:FindFirstChild("Film")
if not video or not video:IsA("VideoFrame") then return end
local id=tonumber(model:GetAttribute("KinVideoAssetId")) or DEFAULT_VIDEO_ID
local usable=id>0 and id==math.floor(id)
video.Video=if usable then "rbxassetid://"..tostring(id) else ""
local text=surface:FindFirstChild("Message")
if text and text:IsA("TextLabel") then
text.Text=if usable then "MONTEZ SUR LA DALLE POUR LANCER LE FILM" else "VIDÉO NON CONFIGURÉE\nAjoutez KinVideoAssetId dans Propriétés"
text.Visible=true
end
end
function Cinema.ensure():Model
local existing=workspace:FindFirstChild(MODEL_NAME)
if existing and existing:IsA("Model") then
if existing:GetAttribute("KinVideoAssetId")==nil then existing:SetAttribute("KinVideoAssetId",DEFAULT_VIDEO_ID) end
setVideo(existing)
return existing
end
local model=Instance.new("Model")
model.Name=MODEL_NAME
model:SetAttribute("KinVideoAssetId",DEFAULT_VIDEO_ID)
model:SetAttribute("KinVideoPlaybackStart",0)
model:SetAttribute("KinVideoLocation","Extérieur — déplaçable dans Studio")
model:SetAttribute("KinVideoTriggerEnabled",true)
model.Parent=workspace
local base=CFrame.new(DEFAULT_POSITION)
local deep=Color3.fromRGB(18,62,60)
local teal=Color3.fromRGB(30,104,100)
local opal=Color3.fromRGB(197,244,240)
local screen=part(model,"Écran",Vector3.new(24,13.5,0.55),base*CFrame.new(0,13,0),Color3.fromRGB(8,18,20),Enum.Material.SmoothPlastic,false)
screen.CanQuery=true
model.PrimaryPart=screen
part(model,"Cadre supérieur",Vector3.new(25,0.6,1),base*CFrame.new(0,20.05,0),teal,Enum.Material.Metal,false)
part(model,"Cadre inférieur",Vector3.new(25,0.6,1),base*CFrame.new(0,5.95,0),teal,Enum.Material.Metal,false)
for _,side in ipairs({-1,1}) do
part(model,"Montant latéral",Vector3.new(0.8,14.5,0.9),base*CFrame.new(side*12.3,13,0),opal,Enum.Material.Metal,false)
part(model,"Pied de structure",Vector3.new(1,6.2,1.2),base*CFrame.new(side*10.4,3.1,0.5),deep,Enum.Material.Metal,true)
end
local trigger=part(model,"Déclencheur vidéo",Vector3.new(10,0.32,8),base*CFrame.new(0,0.16,-15),opal,Enum.Material.Neon,true)
trigger.CanQuery=true
trigger.Transparency=0.28
trigger:SetAttribute("KinVideoTrigger",true)
local strip=part(model,"Repère de projection",Vector3.new(10.6,0.15,0.8),base*CFrame.new(0,0.32,-19.2),teal,Enum.Material.Metal,false)
strip.CanQuery=false
local surface=Instance.new("SurfaceGui")
surface.Name="Projection"
surface.Face=Enum.NormalId.Front
surface.CanvasSize=Vector2.new(1280,720)
surface.LightInfluence=0
surface.AlwaysOnTop=false
surface.Parent=screen
local video=Instance.new("VideoFrame")
video.Name="Film"
video.Size=UDim2.fromScale(1,1)
video.BackgroundColor3=Color3.fromRGB(7,16,19)
video.BorderSizePixel=0
video.Video=""
video.Volume=0.65
video.Looped=false
video.Playing=false
video.Parent=surface
local message=label(surface,"Message","VIDÉO NON CONFIGURÉE",UDim2.fromScale(0.90,0.37),UDim2.fromScale(0.05,0.315),opal,68)
message.ZIndex=3
local heading=label(surface,"En-tête","KOALI • PROJECTION",UDim2.fromScale(0.8,0.1),UDim2.fromScale(0.1,0.04),opal,32)
heading.ZIndex=4
setVideo(model)
return model
end
function Cinema.start()
if started then return end
started=true
local model=Cinema.ensure()
model:GetAttributeChangedSignal("KinVideoAssetId"):Connect(function() setVideo(model) end)
local trigger=model:FindFirstChild("Déclencheur vidéo")
if not trigger or not trigger:IsA("BasePart") then return end
local inside:{[number]:boolean}={}
local lastPlay=-math.huge
task.spawn(function()
while model.Parent and trigger.Parent do
for _,player in ipairs(Players:GetPlayers()) do
local character=player.Character
local humanoid=character and character:FindFirstChildOfClass("Humanoid")
local root=character and character:FindFirstChild("HumanoidRootPart")
local entered=false
if humanoid and humanoid.Health>0 and root and root:IsA("BasePart") then
local rel=trigger.CFrame:PointToObjectSpace(root.Position)
entered=math.abs(rel.X)<trigger.Size.X*0.5 and math.abs(rel.Z)<trigger.Size.Z*0.5 and math.abs(rel.Y)<6
end
local id=player.UserId
if entered and not inside[id] then
if model:GetAttribute("KinVideoTriggerEnabled")~=false and os.clock()-lastPlay>2.5 then
lastPlay=os.clock()
model:SetAttribute("KinVideoPlaybackStart",workspace:GetServerTimeNow())
end
end
inside[id]=entered
end
task.wait(0.35)
end
end)
print("KIN CITY CINÉMA : écran extérieur prêt, vidéo Roblox à configurer dans KinVideoAssetId")
end
return Cinema

]])
source(server,"OuterIslands",[[
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local F=require(script.Parent.Factory)
local Destinations=require(ReplicatedStorage:WaitForChild("KinCityShared"):WaitForChild("IslandDestinations"))
local Islands={}
local NAVY=Color3.fromRGB(30,104,100)
local STONE=Color3.fromRGB(219,210,190)
local WOOD=Color3.fromRGB(147,108,76)
local GOLD=Color3.fromRGB(218,178,106)
local function add(parent,name,cf,size,color,material,solid)
local p=F.part(parent,name,size,cf,color,material)
if solid==false then p.CanCollide=false;p.CanTouch=false end
return p
end
local function localPart(parent,name,base,x,y,z,w,h,d,color,mat,solid)
return add(parent,name,base*CFrame.new(x,y,z),Vector3.new(w,h,d),color,mat,solid)
end
local function rounded(parent,name,cf,diameter,height,color)
local p=add(parent,name,cf*CFrame.Angles(0,0,math.pi/2),Vector3.new(height,diameter,diameter),color,Enum.Material.Grass,true)
p.Shape=Enum.PartType.Cylinder
return p
end
local function globe(parent,name,cf,d,clr,mat)
local p=add(parent,name,cf,Vector3.new(d,d,d),clr,mat or Enum.Material.SmoothPlastic,false)
p.Shape=Enum.PartType.Ball
return p
end
local function plantedTree(parent,base,index,x,z)
local height=8+(index%3)*2
localPart(parent,"Tronc de l'île",base,x,height/2,z,1.4,height,1.4,WOOD,Enum.Material.Wood,true)
local leaf=globe(parent,"Feuillage insulaire",base*CFrame.new(x,height+2.4,z),7+(index%2)*2,Color3.fromRGB(73+(index%3)*10,154+(index%2)*17,116),Enum.Material.Grass)
leaf.CanCollide=false
end
local function bridge(root,item)
local t=item.angle
local radial=Vector3.new(math.cos(t),0,math.sin(t))
local tangent=Vector3.new(-radial.Z,0,radial.X)
local bridgeRoot=F.folder(root,"Passerelle — "..item.title)
bridgeRoot:SetAttribute("KinBridgeId",item.id)
local function height(f)
if f<0.23 then return 0.35+16*(f/0.23) end
if f>0.76 then return 0.35+16*((1-f)/0.24) end
return 16.35
end
local pieces=28
local from=477
local to=701
for step=1,pieces do
local f1=(step-1)/pieces
local f2=step/pieces
local a=radial*(from+(to-from)*f1)+Vector3.new(0,height(f1),0)
local b=radial*(from+(to-from)*f2)+Vector3.new(0,height(f2),0)
local segment=b-a
local length=segment.Magnitude
local cf=CFrame.lookAt((a+b)/2,b)
add(bridgeRoot,"Tablier du pont",cf,Vector3.new(12,0.85,length+0.12),STONE,Enum.Material.Cobblestone,true)
for _,side in ipairs({-1,1}) do
local rail=add(bridgeRoot,"Garde-corps",cf*CFrame.new(side*5.7,2.2,0),Vector3.new(0.3,0.55,length+0.16),GOLD,Enum.Material.Metal,false)
rail.CanCollide=false
if step%2==0 then
add(bridgeRoot,"Balustre",cf*CFrame.new(side*5.7,1.0,0),Vector3.new(0.38,2.0,0.38),NAVY,Enum.Material.Metal,true)
end
end
if step%7==0 then
local pos=(a+b)/2-tangent*0
for _,side in ipairs({-1,1}) do
local lamp=globe(bridgeRoot,"Lanterne de liaison",CFrame.new(pos+tangent*side*5.8+Vector3.new(0,4,0)),1.0,Color3.fromRGB(255,226,151),Enum.Material.Neon)
lamp.CanCollide=false
end
end
end
return bridgeRoot
end
local function islandSection(parent,item,index)
local angle=item.angle
local radial=Vector3.new(math.cos(angle),0,math.sin(angle))
local origin=radial*item.radius
local base=CFrame.new(origin)*CFrame.Angles(0,math.pi/2-angle,0)
local clr=Color3.fromRGB(item.color[1],item.color[2],item.color[3])
local model=Instance.new("Model")
model.Name=item.title
model:SetAttribute("KinIslandId",item.id)
model.Parent=parent
rounded(model,"Terre de l'île",CFrame.new(origin+Vector3.new(0,-2.2,0)),90,5.4,Color3.fromRGB(73,143,104))
rounded(model,"Pavement insulaire",CFrame.new(origin+Vector3.new(0,0.55,0)),53,0.4,STONE)
localPart(model,"Esplanade",base,0,0.7,-15,17,0.35,48,STONE,Enum.Material.Cobblestone,true)
for k=1,10 do
local a=k*2.399963+index
local radius=26+(k%3)*4
local x=math.cos(a)*radius
local z=math.sin(a)*radius
plantedTree(model,base,k,x,z)
end
for n=1,3 do
local a=(n-1)*math.pi*2/3+0.5
local x,z=math.cos(a)*25,math.sin(a)*25
localPart(model,"Sol du kiosque",base,x,0.9,z,17,0.55,15,STONE,Enum.Material.Marble,true)
for _,dx in ipairs({-7,7}) do for _,dz in ipairs({-6,6}) do
localPart(model,"Colonne d'abri",base,x+dx,5.6,z+dz,0.8,9.3,0.8,NAVY,Enum.Material.Metal,true)
end end
localPart(model,"Toit d'abri",base,x,10.5,z,19,1.2,17,clr,Enum.Material.Slate,false)
local bench=Instance.new("Seat")
bench.Name="Banc de l'île";bench.Size=Vector3.new(5,0.8,2.8)
bench.CFrame=base*CFrame.new(x,1.5,z)
bench.Anchored=true;bench.Color=WOOD;bench.Material=Enum.Material.WoodPlanks;bench.Parent=model
end
local exhibit=Instance.new("Model")
exhibit.Name="Installation — "..item.caption
exhibit.Parent=model
localPart(exhibit,"Piédestal de l'installation",base,0,2.1,9,13,3.6,13,NAVY,Enum.Material.Marble,true)
if item.kind=="gardens" then
for ring=1,3 do
local d=3+ring*2.6
for k=1,8 do
local a=k*math.pi/4
local flower=globe(exhibit,"Jardin lumineux",base*CFrame.new(math.cos(a)*d,4.1+ring*0.25,9+math.sin(a)*d),1.2,Color3.fromHSV((k/8+ring*0.13)%1,0.52,0.94),Enum.Material.Neon)
flower:SetAttribute("KinIslandReactive",true)
end
end
elseif item.kind=="arts" then
for k=1,8 do
local a=k*math.pi/4
local sculpture=localPart(exhibit,"Sculpture de scène",base,math.sin(a)*4.7,5.6+math.sin(a)*1.5,9+math.cos(a)*4.7,1.1,4.8,1.1,clr,Enum.Material.Neon,false)
sculpture:SetAttribute("KinIslandReactive",true)
end
elseif item.kind=="energy" then
for k=1,6 do
