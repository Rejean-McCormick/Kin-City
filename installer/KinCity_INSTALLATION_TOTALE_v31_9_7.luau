for _,s in ipairs({-1,1}) do
part(parent,"Montant de rampe",origin,x+s*3.95,rise+1.55,z,0.24,3.1,0.24,accent,Enum.Material.Metal,false)
end
end
end
for _,s in ipairs({-1,1}) do
