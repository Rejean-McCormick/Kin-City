local Trail={}
local captions={
{"La place centrale","La ville est organisée autour d'un espace commun."},
{"Les huit quartiers","Chaque quartier possède une identité et des usages distincts."},
{"Le lac annulaire","Les paysages naturels peuvent inspirer l'urbanisme."},
{"La bibliothèque","Les connaissances deviennent plus utiles quand elles sont partagées."},
{"La démarche scientifique","Observer, tester et expliquer sont trois étapes complémentaires."},
{"Le jardin vivant","Une ville peut offrir de nombreux habitats à la biodiversité."},
{"Les métiers du monde","Les techniques s'apprennent aussi par l'expérimentation."},
{"L'architecture civique","Un bâtiment public doit accueillir différentes personnes."},
{"Les matériaux","Bois, pierre et métal ont des propriétés différentes."},
{"Le cycle de l'eau","L'eau circule entre la terre, les rivières et l'atmosphère."},
{"La lumière du jour","L'orientation des bâtiments influence leur ensoleillement."},
{"La mobilité douce","Des rues piétonnes donnent une place au déplacement lent."},
{"Les rencontres","Les espaces communs permettent des échanges inattendus."},
{"L'observation","Voir un phénomène ne suffit pas toujours à l'expliquer."},
{"La création","Arts et sciences peuvent enrichir une même expérience."},
{"La transmission","L'enseignement relie les générations et les communautés."},
{"Le patrimoine","Préserver une trace aide à comprendre son histoire."},
{"Le dialogue","Écouter plusieurs perspectives améliore la compréhension."},
{"L'éthique","Une décision peut avoir des conséquences différentes selon les personnes."},
{"La collaboration","Un projet collectif demande une coordination explicite."},
{"La réparation","Réutiliser et réparer peut limiter le gaspillage."},
{"L'énergie","Toute transformation d'énergie a des contraintes physiques."},
{"Le temps long","Une ville évolue et se transforme au fil des usages."},
{"Le chemin parcouru","Explorer un lieu aide à se construire des repères."},
}
function Trail.make(city)
local root=F.folder(city,"Sentier pédagogique — 24 haltes")
for i,item in ipairs(captions) do
local a=(i-1)*math.pi*2/#captions+0.09
local r=376+(i%2)*6
local x,z=math.cos(a)*r,math.sin(a)*r
local angle=math.pi/2-a
local base=CFrame.new(x,0,z)*CFrame.Angles(0,angle,0)
local m=Instance.new("Model")
m.Name=string.format("Halte %02d — %s",i,item[1]);m.Parent=root
local floor=F.part(m,"Pavement de la halte",Vector3.new(9,0.24,7),base*CFrame.new(0,-0.14,0),Color3.fromRGB(216,206,184),Enum.Material.Cobblestone)
local pedestal=F.part(m,"Borne de découverte",Vector3.new(2.3,3.6,1.6),base*CFrame.new(0,1.9,0.5),Color3.fromRGB(42,71,82),Enum.Material.Metal)
pedestal:SetAttribute("KinTrailId",string.format("kin.trail.%02d",i))
pedestal:SetAttribute("KinTrailTitle",item[1]);pedestal:SetAttribute("KinTrailText",item[2])
F.prompt(pedestal,"Découvrir",item[1])
local cap=F.part(m,"Lanterne",Vector3.new(1.7,0.75,1.7),base*CFrame.new(0,4.0,0.5),Color3.fromRGB(241,208,146),Enum.Material.Neon)
cap.CanCollide=false
F.sign(m,"Plaque",(base*CFrame.new(0,5.6,0.5)).Position,math.deg(angle),string.format("%02d  %s",i,item[1]),12,2.1).CanCollide=false
end
root:SetAttribute("KinTrailStops",#captions)
return root
end
function Trail.isReserved(x,z)
for i=1,#captions do
local a=(i-1)*math.pi*2/#captions+0.09
local r=376+(i%2)*6
local dx=x-math.cos(a)*r
local dz=z-math.sin(a)*r
if dx*dx+dz*dz<11*11 then return true end
end
return false
end
return Trail

]])
source(server,"DistrictChromatics",[[
local F=require(script.Parent.Factory)
local Palette=require(game:GetService("ReplicatedStorage"):WaitForChild("KinCityShared"):WaitForChild("HexagonalDistricts"))
local Chromatics={}
local function decal(parent,name,size,cf,color,material)
local p=F.part(parent,name,size,cf,color,material)
p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=false
return p
end
local function segment(parent,a,b,section)
local d=b-a
local frame=CFrame.new((a+b)*0.5)*CFrame.Angles(0,-math.atan2(d.Z,d.X),0)
decal(parent,"Tracé "..section.name,Vector3.new(d.Magnitude,0.10,2.0),frame,
section.color,Enum.Material.SmoothPlastic).Transparency=0.16
decal(parent,"Fil sarcelle",Vector3.new(d.Magnitude,0.10,0.31),
frame*CFrame.new(0,0.09,0),Palette.base,Enum.Material.Neon)
end
function Chromatics.make(city,plan)
local root=F.folder(city,"Repères chromatiques • 6 secteurs")
root:SetAttribute("KinReferenceTeal","#1E6864")
for _,s in ipairs(Palette.sections) do
local axis=Vector3.new(s.x,0,s.z)
for j=1,13 do
local r=70+(j-1)*24
local a=axis*r+Vector3.new(0,0.74,0)
local b=axis*(r+17)+Vector3.new(0,0.74,0)
segment(root,a,b,s)
end
for _,r in ipairs({102,290,391}) do
local p=axis*r
decal(root,"Balise "..s.name,Vector3.new(2.1,1.4,2.1),
CFrame.new(p+Vector3.new(0,1.2,0)),s.color,Enum.Material.Neon).Transparency=0.1
decal(root,"Socle sarcelle",Vector3.new(3.1,0.5,3.1),
CFrame.new(p+Vector3.new(0,0.38,0)),Palette.base,Enum.Material.Metal)
end
end
local seen={}
for _,route in ipairs(plan.pedestrian_paths) do
local pts=route.path_xyz_studs
for i=2,#pts do
local first=Vector3.new(pts[i-1][1],0,pts[i-1][3])
local last=Vector3.new(pts[i][1],0,pts[i][3])
local travel=last-first
if travel.Magnitude>0 then
for n=1,math.floor(travel.Magnitude/27) do
local p=first+travel.Unit*n*27
local key=math.floor(p.X/9)..":"..math.floor(p.Z/9)
if p.Magnitude>73 and not seen[key] then
local s=Palette.nearestAxis(p.X,p.Z)
if s then
seen[key]=true
local marker=decal(root,"Point de repère "..s.name,
Vector3.new(2.1,0.16,2.1),CFrame.new(p+Vector3.new(0,0.72,0)),
s.color,Enum.Material.Neon)
marker:SetAttribute("KinSector",s.key)
end
end
end
end
end
end
return root
end
return Chromatics

]])
source(server,"DistrictLandmarks",[[
local F=require(script.Parent.Factory)
local Districts=require(game:GetService("ReplicatedStorage"):WaitForChild("KinCityShared"):WaitForChild("HexagonalDistricts"))
local Landmarks={}
local TEAL=Districts.base
local function ornament(parent,name,size,cf,color,material)
local p=F.part(parent,name,size,cf,color,material)
p.CanCollide=false;p.CanTouch=false;p.CanQuery=false
return p
end
local function text(parent,name,at,string,width)
local board=F.sign(parent,name,at,0,string,width or 24,3.0)
board.CanCollide=false
return board
end
local function nearBuilding(x,z,structures,pad)
for _,b in ipairs(structures) do
local dx=x-b.center_studs[1]
local dz=z-b.center_studs[3]
local yaw=math.rad(b.yaw_degrees)
local lx=math.cos(yaw)*dx-math.sin(yaw)*dz
local lz=math.sin(yaw)*dx+math.cos(yaw)*dz
if math.abs(lx)<b.footprint_studs[1]/2+pad and math.abs(lz)<b.footprint_studs[2]/2+pad then return true end
end
return false
end
local function site(section,structures)
local axis=Vector3.new(section.x,0,section.z)
local across=Vector3.new(-axis.Z,0,axis.X)
for _,r in ipairs({151,177,130,205,234}) do
for _,offset in ipairs({0,23,-23,44,-44}) do
local p=axis*r+across*offset
if not nearBuilding(p.X,p.Z,structures,23) then return p end
end
end
return axis*174 -- Toujours dans le bon secteur si l'urbanisme évolue.
end
local function renderTheme(parent,section,at)
local kind=section.material
if kind=="metal" then
for i=-2,2 do
ornament(parent,"Colonne acier brossé",Vector3.new(1.8,9,1.8),CFrame.new(at+Vector3.new(i*7.1,5.4,0)),
section.secondary,Enum.Material.Metal)
ornament(parent,"Module expérimental",Vector3.new(4.7,2.1,4.7),
CFrame.new(at+Vector3.new(i*7.1,10.7,0)),section.lightColor,Enum.Material.Glass)
ornament(parent,"Trait d'énergie",Vector3.new(3.8,0.36,3.8),CFrame.new(at+Vector3.new(i*7.1,11.9,0)),
section.lightColor,Enum.Material.Neon)
end
elseif kind=="wood" then
for i=-2,2 do
ornament(parent,"Pilotis de bois",Vector3.new(2.1,8.5,2.1),CFrame.new(at+Vector3.new(i*7.2,5.3,0)),
section.secondary,Enum.Material.WoodPlanks)
ornament(parent,"Linteau éthique",Vector3.new(6.5,1.1,4.7),CFrame.new(at+Vector3.new(i*7.2,10.1,0)),
section.color,Enum.Material.Wood)
end
ornament(parent,"Table de concertation",Vector3.new(26,1.15,6),
CFrame.new(at+Vector3.new(0,2.2,-5)),TEAL,Enum.Material.Wood)
elseif kind=="black_marble" then
for i=-2,2 do
local x=i*7
ornament(parent,"Marbre noir",Vector3.new(6.3,11.3,3.1),
CFrame.new(at+Vector3.new(x,6.9,0)),section.dark,Enum.Material.Marble)
for n=1,3 do
ornament(parent,"Veinure dorée",Vector3.new(0.22,10.1,0.15),
CFrame.new(at+Vector3.new(x+(n-2)*1.65,7,1.62))*CFrame.Angles(0,0,math.rad(12+n*13)),
Districts.gold,Enum.Material.Metal)
end
ornament(parent,"Inclusion sarcelle",Vector3.new(5.6,0.46,3.4),
CFrame.new(at+Vector3.new(x,12.7,0)),section.lightColor,Enum.Material.Neon)
end
elseif kind=="monochrome" then
for i=-2,2 do
local white=i%2==0
ornament(parent,"Voile noir et blanc",Vector3.new(6.5,10.5,2.2),
CFrame.new(at+Vector3.new(i*7.1,6.9,0)),
if white then section.pale else section.dark,Enum.Material.SmoothPlastic)
ornament(parent,"Relais Kristal",Vector3.new(1.3,1.3,2.65),
CFrame.new(at+Vector3.new(i*7.1,7.8,1.6)),section.lightColor,Enum.Material.Neon)
end
for i=-2,1 do
ornament(parent,"Relation entre connaissances",Vector3.new(7,0.37,0.37),
CFrame.new(at+Vector3.new(i*7.1+3.55,7.8,1.7)),section.lightColor,Enum.Material.Neon)
end
elseif kind=="academy" then
for i=-2,2 do
ornament(parent,"Pilier pédagogique",Vector3.new(3.2,9.6,3.2),
CFrame.new(at+Vector3.new(i*7.2,6.2,0)),section.dark,Enum.Material.Slate)
ornament(parent,"Capitelle de progression",Vector3.new(5.2,1.1,5.2),
CFrame.new(at+Vector3.new(i*7.2,11.4,0)),section.color,Enum.Material.Marble)
ornament(parent,"Éclair de parcours",Vector3.new(1.1,2.5,0.35),
CFrame.new(at+Vector3.new(i*7.2,6.5,-1.75)),section.lightColor,Enum.Material.Neon)
end
elseif kind=="creative" then
for i=-2,2 do
local sculpture=ornament(parent,"Oeuvre dynamique Kreative",Vector3.new(4.5,5,4.5),
CFrame.new(at+Vector3.new(i*7.1,7,0))*CFrame.Angles(math.rad(12),i*0.25,math.rad(17+i*8)),
section.color,Enum.Material.Glass)
sculpture:SetAttribute("KinKreativeCanvas",true)
sculpture:SetAttribute("KinArtElement",i)
ornament(parent,"Pied d'œuvre",Vector3.new(3,5,3),CFrame.new(at+Vector3.new(i*7.1,2.5,0)),
TEAL,Enum.Material.Metal)
end
end
end
local VOTE_OPTIONS={
{id="cuivre",label="Cuivre & corail",color=Color3.fromRGB(206,132,106)},
{id="nuit",label="Nuit opaline",color=Color3.fromRGB(90,124,165)},
{id="prune",label="Prune & ivoire",color=Color3.fromRGB(155,111,164)},
}
Landmarks.themeOptions=VOTE_OPTIONS
function Landmarks.make(city,plan)
local roots=F.folder(city,"Six secteurs • identités matérielles")
roots:SetAttribute("KinArtSharedColor","#1E6864")
for _,s in ipairs(Districts.sections) do
local folder=F.folder(roots,s.name)
folder:SetAttribute("KinSector",s.key)
folder:SetAttribute("KinClockHour",s.hour)
folder:SetAttribute("KinThemeMaterial",s.material)
folder:SetAttribute("KinSectorSystem",s.system)
local at=site(s,plan.structures)
folder:SetAttribute("KinExhibitionCenter",at)
local base=ornament(folder,"Parvis thématique",Vector3.new(43,0.25,36),
CFrame.new(at+Vector3.new(0,0.23,0)),s.pale,Enum.Material.SmoothPlastic)
base.Transparency=0.2
renderTheme(folder,s,at)
if s.key=="kreative" then
for _,piece in ipairs(folder:GetDescendants()) do
if piece:IsA("BasePart") and
(piece.Material==Enum.Material.Neon and not string.find(piece.Name,"Échantillon",1,true)) then
piece:SetAttribute("KinKreativeCanvas",true)
end
end
end
for side=-1,1,2 do
local shaft=ornament(folder,"Signal lumineux de district",Vector3.new(0.65,11.5,0.65),
CFrame.new(at+Vector3.new(side*21,6,0)),s.lightColor,Enum.Material.Neon)
local cap=ornament(folder,"Accent secondaire",Vector3.new(1.7,1.7,1.7),
CFrame.new(at+Vector3.new(side*21,12.4,0)),s.lightColor,Enum.Material.Glass)
local light=Instance.new("PointLight")
light.Name="Lueur du secteur"
light.Brightness=0.38;light.Range=16;light.Shadows=false;light.Color=s.lightColor;light.Parent=cap
if s.key=="kreative" then
shaft:SetAttribute("KinKreativeCanvas",true)
cap:SetAttribute("KinKreativeCanvas",true)
light:SetAttribute("KinKreativeLight",true)
end
end
if s.key=="kreative" then
local board=text(folder,"Résultat de l'ambiance",at+Vector3.new(0,15,-20),
"THÈME KREATIVE\nCuivre & corail",24)
board:SetAttribute("KinKreativeResults",true)
folder:SetAttribute("KinKreativeActiveTheme","cuivre")
folder:SetAttribute("KinKreativeVoteScope","session_cosmetic_only")
for i,option in ipairs(VOTE_OPTIONS) do
local p=at+Vector3.new((i-2)*11,0,-31)
local terminal=ornament(folder,"Choisir "..option.label,Vector3.new(7.7,6.1,3.9),
CFrame.new(p+Vector3.new(0,3.5,0)),TEAL,Enum.Material.Metal)
terminal:SetAttribute("KinKreativeThemeId",option.id)
terminal:SetAttribute("KinKreativeLocalOnly",true)
ornament(folder,"Échantillon "..option.label,Vector3.new(6.7,2.1,0.3),
CFrame.new(p+Vector3.new(0,4.8,-2.08)),option.color,Enum.Material.Neon)
local prompt=F.prompt(terminal,"Voter pour l'ambiance",option.label)
prompt.HoldDuration=0.25
prompt.MaxActivationDistance=13
text(folder,"Nom du thème "..option.id,p+Vector3.new(0,9,0),option.label,12)
end
end
local yaw=math.atan2(-s.x,s.z)
local pivot=CFrame.new(at)*CFrame.Angles(0,yaw,0)*CFrame.new(-at)
for _,piece in ipairs(folder:GetDescendants()) do
if piece:IsA("BasePart") then piece.CFrame=pivot*piece.CFrame end
end
end
return roots
end
return Landmarks

]])
source(server,"EkohHalo",[[
local F=require(script.Parent.Factory)
local Palette=require(game:GetService("ReplicatedStorage"):WaitForChild("KinCityShared"):WaitForChild("HexagonalDistricts"))
local Halo={}
local RADIUS=211
local HEIGHT=17
local SEGMENTS=96
local ANGLES=math.pi*2
local function deco(parent,name,size,cf,color,material)
local p=F.part(parent,name,size,cf,color,material)
p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=false
return p
end
local function beam(parent,name,a,b,width,height,color,material)
local d=b-a
return deco(parent,name,Vector3.new(d.Magnitude,height,width),
CFrame.new((a+b)*0.5)*CFrame.Angles(0,-math.atan2(d.Z,d.X),0),color,material)
end
local function buildingNearby(x,z,structures,pad)
for _,b in ipairs(structures) do
local dx,dz=x-b.center_studs[1],z-b.center_studs[3]
local yaw=math.rad(b.yaw_degrees)
local lx=math.cos(yaw)*dx-math.sin(yaw)*dz
local lz=math.sin(yaw)*dx+math.cos(yaw)*dz
if math.abs(lx)<b.footprint_studs[1]/2+pad and math.abs(lz)<b.footprint_studs[2]/2+pad then return true end
end
return false
end
local function kioskPlace(direction,structures)
local side=Vector3.new(-direction.Z,0,direction.X)
for _,r in ipairs({RADIUS,RADIUS-10,RADIUS+10,RADIUS-20,RADIUS+20}) do
for _,offset in ipairs({0,12,-12,23,-23}) do
local p=direction*r+side*offset
if not buildingNearby(p.X,p.Z,structures,9) then return p end
end
end
return direction*RADIUS
end
local topics={
keenkonnect={"Collaboration", "Konstruct • TeamBuilder", "Konnaxion"},
ethikos={"Éthique & expertise", "Contexte EkoH • accès privé", "Konnaxion"},
kreative={"Création & mémoire", "Konservation • œuvres", "Konnaxion"},
uckk={"Parcours", "Cours • activités • communauté", "Université King Klown"},
ekole={"Connaissance", "Kristals • perspectives", "Ekole / Konstellation"},
konnected={"Apprendre & valider", "Knowledge • CertifiKation", "Konnaxion"},
}
function Halo.make(city,plan)
local root=F.folder(city,"EkoH • halo transversal lumineux")
root:SetAttribute("KinHaloOwner","Konnaxion/EkoH")
root:SetAttribute("KinColor","#1E6864")
root:SetAttribute("KinRadiusStuds",RADIUS)
root:SetAttribute("KinHeightStuds",HEIGHT)
root:SetAttribute("KinScope","interpretation_and_wayfinding_only")
root:SetAttribute("KinRingSegments",SEGMENTS)
for i=0,SEGMENTS-1 do
local a=i*ANGLES/SEGMENTS
local b=(i+1)*ANGLES/SEGMENTS
local p=Vector3.new(math.cos(a)*RADIUS,HEIGHT,math.sin(a)*RADIUS)
local q=Vector3.new(math.cos(b)*RADIUS,HEIGHT,math.sin(b)*RADIUS)
beam(root,"Structure du halo EkoH",p,q,1.8,1.0,Palette.base,Enum.Material.Metal)
beam(root,"Lumière EkoH",p+Vector3.new(0,0.58,0),
q+Vector3.new(0,0.58,0),0.7,0.3,Palette.light,Enum.Material.Neon)
if i%8==0 then
local point=deco(root,"Source de lumière",Vector3.new(1.3,1.3,1.3),
CFrame.new(p+Vector3.new(0,0.8,0)),Palette.light,Enum.Material.Neon)
local light=Instance.new("PointLight")
light.Color=Palette.light
light.Brightness=0.8
light.Range=31
light.Shadows=false
light.Parent=point
end
end
local posts=F.folder(root,"Bornes EkoH aux six axes")
for _,section in ipairs(Palette.sections) do
local direction=Vector3.new(section.x,0,section.z)
local p=kioskPlace(direction,plan.structures)
local group=F.folder(posts,"Borne "..section.name)
group:SetAttribute("KinSector",section.key)
group:SetAttribute("KinTheme",section.material)
local yaw=math.atan2(section.x,section.z)
local frame=CFrame.new(p)*CFrame.Angles(0,yaw,0)
local boardWidth=25
local signY=10.3
local supportHeight=13.0
local supportDistance=boardWidth/2+1.1
for _,side in ipairs({-1,1}) do
local foot=(frame*CFrame.new(side*supportDistance,supportHeight/2,0)).Position
local post=deco(group,"Colonne latérale du portique",Vector3.new(supportHeight,0.78,0.78),
CFrame.new(foot)*CFrame.Angles(0,0,math.pi/2),Palette.base,Enum.Material.Metal)
post.Shape=Enum.PartType.Cylinder
post:SetAttribute("KinSignStructuralSupport",true)
local link=deco(group,"Fixation latérale du panneau",Vector3.new(1.4,0.22,0.38),
frame*CFrame.new(side*(boardWidth/2+0.4),signY,0),Palette.light,Enum.Material.Metal)
link:SetAttribute("KinSignStructuralSupport",true)
end
group:SetAttribute("KinSignSupportRevision","KC36-twin-post-clear-center")
local terminal=deco(group,"Borne d'exploration",Vector3.new(5.4,5.3,3.5),
frame*CFrame.new(0,3.5,0),Palette.base,Enum.Material.Metal)
deco(group,"Façade éclairée",Vector3.new(4.6,3.0,0.32),
frame*CFrame.new(0,4.2,-1.94),Palette.light,Enum.Material.Neon).Transparency=0.3
deco(group,"Sommet coloré",Vector3.new(5.7,0.5,3.6),
frame*CFrame.new(0,6.35,0),section.color,Enum.Material.Neon)
local meta=topics[section.key]
local sign=F.sign(group,"EkoH • "..section.name,p+Vector3.new(0,signY,0),math.deg(yaw),
"EkoH • "..meta[1].."\n"..meta[2],boardWidth,3.7,
{section=section.key,doubleSided=true})
sign:SetAttribute("KinDisclosure","Découverte publique, aucune donnée personnelle")
sign:SetAttribute("KinSignMount","twin-post")
terminal:SetAttribute("KinStubInteractionId","ekoh.terminal."..section.key)
terminal:SetAttribute("KinStubCapabilityId","ekoh.public.exploration")
terminal:SetAttribute("KinStubTitle","EkoH • "..section.name)
F.prompt(terminal,"Découvrir",meta[3].." / EkoH")
end
local links=F.folder(root,"Systèmes transversaux")
local cross={
{angle=-math.pi/3,title="ORGO",detail="Coordonner • transmettre"},
{angle=2*math.pi/3,title="KONSTELLATION",detail="Explorer • relier"},
}
for _,item in ipairs(cross) do
local p=kioskPlace(Vector3.new(math.cos(item.angle),0,math.sin(item.angle)),plan.structures)
local terminal=deco(links,"Kiosque "..item.title,Vector3.new(4.5,5,2.8),
CFrame.new(p+Vector3.new(0,3.1,0)),Palette.base,Enum.Material.Metal)
terminal:SetAttribute("KinStubInteractionId","ekoh.cross."..item.title)
terminal:SetAttribute("KinStubCapabilityId","ecosystem.public.discover")
terminal:SetAttribute("KinStubTitle",item.title)
F.prompt(terminal,"Explorer",item.title)
F.sign(links,"Passerelle "..item.title,p+Vector3.new(0,8.8,0),0,
item.title.."\n"..item.detail,28,3.4)
end
return root
end
return Halo

]])
source(server,"FacadeDetail",[[
local F=require(script.Parent.Factory)
local Detail={}
local pale=Color3.fromRGB(230,225,213)
local dark=Color3.fromRGB(18,62,60)
local function part(parent,name,base,offset,size,color,mat,solid)
local p=F.part(parent,name,size,base*CFrame.new(offset),color,mat or Enum.Material.Metal)
if solid==false then p.CanCollide=false;p.CastShadow=false end
return p
end
function Detail.make(model,structure,building,style)
local cx,cy,cz=table.unpack(structure.center_studs)
local width,depth=table.unpack(structure.footprint_studs)
local height=structure.height_studs
local base=CFrame.new(cx,cy,cz)*CFrame.Angles(0,math.rad(structure.yaw_degrees),0)
local accent=F.hex(style.palette.accent)
local trim=F.hex(style.palette.trim)
local folder=F.folder(model,"Détails façades v4")
part(folder,"Auvent",base,Vector3.new(0,10,-depth/2-5.2),Vector3.new(20,0.85,9),trim,Enum.Material.Marble,false)
for _,s in ipairs({-1,1}) do
part(folder,"Pylône d'entrée",base,Vector3.new(s*9.2,5,-depth/2-6.5),Vector3.new(1.7,10,1.7),accent,Enum.Material.Marble,false)
part(folder,"Ornement d'entrée",base,Vector3.new(s*9.2,10.6,-depth/2-6.5),Vector3.new(3.1,1.1,3.1),trim,Enum.Material.Metal,false)
part(folder,"Hampe verticale",base,Vector3.new(s*12.4,15,-depth/2-0.8),Vector3.new(0.3,10,0.3),dark,Enum.Material.Metal,false)
part(folder,"Bannière",base,Vector3.new(s*12.4,14.5,-depth/2-1.4),Vector3.new(3.2,6.6,0.15),accent,Enum.Material.Fabric,false)
part(folder,"Pointe bannière",base,Vector3.new(s*12.4,10.7,-depth/2-1.4),Vector3.new(0.85,0.6,0.25),pale,Enum.Material.Metal,false)
end
local levels=math.max(1,math.min(5,math.floor(height/9)))
local count=math.max(2,math.min(8,math.floor(width/12)))
for floor=1,levels do
local y=6+floor*6
if y<height-4 then
for n=1,count do
local x=-width/2+n*width/(count+1)
local z=-depth/2-0.47
part(folder,"Linteau sculpté",base,Vector3.new(x,y+2.25,z),Vector3.new(5,0.45,0.55),trim,Enum.Material.Marble,false)
part(folder,"Appui de fenêtre",base,Vector3.new(x,y-2.35,z),Vector3.new(5.2,0.48,0.8),trim,Enum.Material.Marble,false)
part(folder,"Croisée verticale",base,Vector3.new(x,y,z-0.2),Vector3.new(0.17,4.3,0.25),dark,Enum.Material.Metal,false)
part(folder,"Croisée horizontale",base,Vector3.new(x,y,z-0.2),Vector3.new(4.0,0.14,0.25),dark,Enum.Material.Metal,false)
if floor%2==0 and n%2==0 then
part(folder,"Balcon décoratif",base,Vector3.new(x,y-2.7,z-1.1),Vector3.new(6.2,0.35,2.4),accent,Enum.Material.Metal,false)
part(folder,"Garde-corps balcon",base,Vector3.new(x,y-0.85,z-2.1),Vector3.new(6.2,2.4,0.25),dark,Enum.Material.Metal,false)
end
end
end
end
for n=-2,2 do
local x=n*(width-13)/6
part(folder,"Lucarne principale",base,Vector3.new(x,height+2,0),Vector3.new(5,4,5),trim,Enum.Material.Marble,false)
part(folder,"Verrière de lucarne",base,Vector3.new(x,height+2,-2.7),Vector3.new(3.6,2.4,0.17),Color3.fromRGB(92,175,195),Enum.Material.Glass,false)
end
part(folder,"Lanternon de toiture",base,Vector3.new(0,height+4,0),Vector3.new(10,6,10),Color3.fromRGB(68,112,126),Enum.Material.Glass,false)
part(folder,"Chapeau du lanternon",base,Vector3.new(0,height+7.2,0),Vector3.new(12,0.75,12),accent,Enum.Material.Metal,false)
return folder
end
return Detail

]])
