{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kincity.example.invalid/schemas/kincity.place-recipe-1.0",
  "title": "Kin City KC34 declarative place recipe contribution (NOT a Roblox runtime loader)",
  "type": "object",
  "required": ["schema_version","place_key","owner_branch","requires_contracts_version","recipe_revision","seed_policy","profiles_supported","decorations","implementation_status"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "kincity.place-recipe/1.0"},
    "place_key": {"enum": ["city", "city_hall", "ekoh_tower", "library", "campus", "justice_palace", "innovation_lab", "museum", "orgo_center"]},
    "owner_branch": {"enum": ["B01","B02","B03","B04","B05","B06","B07","B08","B10"]},
    "requires_contracts_version": {"const": "KC34-DOC-1.0"},
    "recipe_revision": {"type":"string", "minLength":1},
    "seed_policy": {"const": "CITY_SEED_XOR_PLACE_HASH"},
    "profiles_supported": {"const": ["LITE","STANDARD","SHOWCASE"]},
    "decorations": {
      "type":"array", "items": {"type":"object", "additionalProperties":false,
        "required":["id","asset_key","anchor_id","min_profile"],
        "properties": {
          "id":{"type":"string","minLength":3},
          "asset_key":{"type":"string","minLength":1},
          "anchor_id":{"type":"string","minLength":1},
          "min_profile":{"enum":["LITE","STANDARD","SHOWCASE"]},
          "notes":{"type":"string"}
        }
      }
    },
    "implementation_status": {"enum":["NOT_CONNECTED_TO_WORLD_BUILDER","INTEGRATION_PROPOSED","CONNECTED_STAGING"]}
  }
}
