{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kincity.example/places.schema.json",
  "title": "Kin City places",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "kincity.places/1.0"
    },
    "places": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "place_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "place_id": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "integer",
                "minimum": 1
              }
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "city",
              "interior"
            ]
          },
          "publication_state": {
            "type": "string",
            "enum": [
              "unpublished",
              "published_private",
              "published_public"
            ]
          },
          "anchors": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
            }
          }
        },
        "required": [
          "place_key",
          "place_id",
          "kind",
          "publication_state",
          "anchors"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "places"
  ],
  "additionalProperties": false
}
