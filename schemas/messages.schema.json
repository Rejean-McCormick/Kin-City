{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kincity.example/messages.schema.json",
  "title": "Kin City messages",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "kincity.messages/1.0"
    },
    "locale": {
      "type": "string",
      "const": "fr-CA"
    },
    "messages": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "locale",
    "messages"
  ],
  "additionalProperties": false
}
