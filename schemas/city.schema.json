{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kincity.example/city.schema.json",
  "title": "Kin City city",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "kincity.city/1.0"
    },
    "city_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "start_place_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "district_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
      }
    },
    "layout": {
      "type": "object",
      "properties": {
        "topology": {
          "type": "string",
          "enum": [
            "concentric"
          ]
        },
        "rings": {
          "type": "integer",
          "minimum": 1
        },
        "radius_units": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "topology",
        "rings",
        "radius_units"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "city_id",
    "display_name",
    "seed",
    "start_place_key",
    "district_ids",
    "layout"
  ],
  "additionalProperties": false
}
