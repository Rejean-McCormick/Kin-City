{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kincity.example/capabilities.schema.json",
  "title": "Kin City capabilities",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "kincity.capabilities/1.0"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "capability_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          },
          "owner_ref": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          },
          "provider_mode": {
            "type": "string",
            "const": "stub"
          },
          "state": {
            "type": "string",
            "const": "planned"
          },
          "operation_kind": {
            "type": "string",
            "enum": [
              "read",
              "write_future"
            ]
          },
          "content_admission": {
            "type": "string",
            "enum": [
              "no_live_content"
            ]
          },
          "message_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          }
        },
        "required": [
          "capability_id",
          "owner_ref",
          "provider_mode",
          "state",
          "operation_kind",
          "content_admission",
          "message_key"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "capabilities"
  ],
  "additionalProperties": false
}
