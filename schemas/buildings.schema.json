{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kincity.example/buildings.schema.json",
  "title": "Kin City buildings",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "kincity.buildings/1.0"
    },
    "buildings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "building_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          },
          "district_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "exterior_template": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          },
          "interior_template": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          },
          "interior_mode": {
            "type": "string",
            "enum": [
              "inline_streamed",
              "separate_place",
              "shared_template_place",
              "event_place"
            ]
          },
          "interior_place_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "entry_door_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          },
          "exit_door_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          },
          "visual_seed": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "building_id",
          "district_id",
          "name",
          "exterior_template",
          "interior_template",
          "interior_mode",
          "interior_place_key",
          "entry_door_id",
          "exit_door_id",
          "visual_seed"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "buildings"
  ],
  "additionalProperties": false
}
