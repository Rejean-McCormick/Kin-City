{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kincity.example/doors.schema.json",
  "title": "Kin City doors",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "kincity.doors/1.0"
    },
    "doors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "door_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          },
          "building_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          },
          "source_place_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "source_anchor_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          },
          "destination_place_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "destination_anchor_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          },
          "return_door_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          },
          "transition_kind": {
            "type": "string",
            "enum": [
              "teleport",
              "local"
            ]
          },
          "is_operational_required": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "door_id",
          "building_id",
          "source_place_key",
          "source_anchor_id",
          "destination_place_key",
          "destination_anchor_id",
          "return_door_id",
          "transition_kind",
          "is_operational_required"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "doors"
  ],
  "additionalProperties": false
}
