{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kincity.example/interactions.schema.json",
  "title": "Kin City interactions",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "kincity.interactions/1.0"
    },
    "interactions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "interaction_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          },
          "building_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          },
          "place_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "anchor_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          },
          "capability_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          },
          "provider_mode": {
            "type": "string",
            "const": "stub"
          },
          "prompt_label_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          },
          "display_title_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          },
          "display_message_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          }
        },
        "required": [
          "interaction_id",
          "building_id",
          "place_key",
          "anchor_id",
          "capability_id",
          "provider_mode",
          "prompt_label_key",
          "display_title_key",
          "display_message_key"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "interactions"
  ],
  "additionalProperties": false
}
