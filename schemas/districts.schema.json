{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kincity.example/districts.schema.json",
  "title": "Kin City districts",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "kincity.districts/1.0"
    },
    "districts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "district_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "symbolic_domain": {
            "type": "string",
            "minLength": 1
          },
          "ring": {
            "type": "integer",
            "minimum": 0
          },
          "angle_degrees": {
            "type": "integer",
            "minimum": 0,
            "maximum": 359
          },
          "hub_anchor_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
          }
        },
        "required": [
          "district_id",
          "name",
          "symbolic_domain",
          "ring",
          "angle_degrees",
          "hub_anchor_id"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "districts"
  ],
  "additionalProperties": false
}
