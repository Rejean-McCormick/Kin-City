{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kincity.example/assets.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "const": "kincity.assets/1.0"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "class",
          "source",
          "generator",
          "license",
          "revision",
          "dependencies",
          "fallback"
        ],
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "class": {
            "enum": [
              "facade",
              "interior",
              "prop",
              "mesh",
              "material",
              "audio"
            ]
          },
          "source": {
            "enum": [
              "native_procedural",
              "local_source",
              "creator_store"
            ]
          },
          "generator": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fallback": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
